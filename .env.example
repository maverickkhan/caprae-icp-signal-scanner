# Gemini (Google AI Studio) — check current model IDs in AI Studio
GOOGLE_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=

# Neon Postgres — pooled connection string (postgresql+asyncpg://...)
DATABASE_URL=

# LangFuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Fetcher
SCANNER_USER_AGENT=ICPSignalScanner/0.1 (+your-email@example.com)
